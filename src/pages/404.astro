---
import Layout from '../layouts/Layout.astro';
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
---
<Layout title="404 — Page not found">
  <div class="container not-found">
    <div class="card">
      <h1 class="error-code">404</h1>
      <h2>Page not found</h2>
      <p class="muted">The page you are looking for does not exist or has been moved.</p>
      <div class="cta">
        <a href={`${base}/`} class="btn btn-dark">← Go home</a>
        <a href={`${base}/cv`} class="btn btn-outline">View CV</a>
        <a href={`${base}/blog`} class="btn btn-outline">Read blog</a>
      </div>
    </div>
  </div>
  <style>
    .not-found{min-height:60vh;display:flex;align-items:center;justify-content:center;padding:48px 0}
    .card{text-align:center;padding:48px;max-width:500px}
    .error-code{font-size:6rem;font-weight:800;line-height:1;letter-spacing:-0.05em;background:linear-gradient(90deg,var(--accent),var(--accent2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:16px}
    .card h2{font-size:1.8rem;margin-bottom:12px;letter-spacing:-0.02em}
    .card p{margin-bottom:32px}
    .cta{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
  </style>
</Layout>