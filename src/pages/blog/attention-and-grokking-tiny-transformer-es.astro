---
// The same redirect for the Spanish version, which moved as well.
const target = '/blog/grokking-from-memory-to-rule-es/';
// The origin comes from `site` in the Astro config, never from a literal in a page.
const site = (Astro.site ?? new URL('https://jacano.github.io')).toString().replace(/\/$/, '');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={`${site}${target}`} />
    <meta name="robots" content="noindex" />
    <title>Movido: Grokking, el salto de la memoria a la regla</title>
  </head>
  <body>
    <p>
      Este artículo se ha movido a <a href={target}>Grokking: el salto de la memoria a la regla</a>.
    </p>
  </body>
</html>
