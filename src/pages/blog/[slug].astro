---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
const slugOf = (p: { id: string }) => p.id.replace(/\.md$/, '').split('/').pop()!;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '').split('/').pop() },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const allPosts = await getCollection('blog');
const sorted = [...allPosts].sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date));
const idx = sorted.findIndex((p) => p.id === post.id);
const prev = sorted[idx + 1];
const next = sorted[idx - 1];
const postSlug = slugOf(post);
---
<Layout title={`${post.data.title} — Juan Antonio Cano`} description={post.data.excerpt} canonicalPath={`/blog/${postSlug}/`}>
  <article class="container post-wrap">
    <div class="meta">
      <a href={`${base}/blog`} class="link">← Back to blog</a>
      <div class="tags">
        <span class="badge">{post.data.tag}</span>
        <span class="mono muted">{post.data.date} · {post.data.read}</span>
      </div>
    </div>
    <h1>{post.data.title}</h1>
    <div class="prose">
      <Content />
    </div>
    {(prev || next) && (
      <nav class="pager">
        {prev ? <a href={`${base}/blog/${slugOf(prev)}`} class="card pager-link"><span class="mono small muted">← Older</span><strong>{prev.data.title}</strong></a> : <span />}
        {next ? <a href={`${base}/blog/${slugOf(next)}`} class="card pager-link right"><span class="mono small muted">Newer →</span><strong>{next.data.title}</strong></a> : <span />}
      </nav>
    )}
    <div class="share card">
      <p class="muted">Was this useful? Share it or contact me.</p>
      <div class="actions">
        <a href="https://www.linkedin.com/in/juanantoniocano/" target="_blank" class="btn btn-outline">Share on LinkedIn</a>
        <a href="mailto:jacanosalado@gmail.com" class="btn btn-dark">Reply by email</a>
      </div>
    </div>
  </article>
  <style>
    .post-wrap{max-width:720px;padding:48px 24px}
    .meta{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:24px;align-items:center}
    .link{color:var(--accent);font-weight:600}
    .badge{padding:4px 10px;border-radius:999px;background:rgba(99,102,241,.15);color:#a5b4fc;font-size:.7rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;border:1px solid rgba(99,102,241,.3)}
    .muted{color:var(--muted)}
    .mono{font-family:'JetBrains Mono',monospace;font-size:.8rem}
    .small{font-size:.75rem}
    h1{font-size:2.2rem;line-height:1.15;letter-spacing:-0.03em;margin-bottom:24px}
    .prose{color:#d4d4d8;line-height:1.8}
    .prose h2{color:var(--text);margin:32px 0 12px;font-size:1.35rem;letter-spacing:-0.02em}
    .prose p{margin:12px 0}
    .prose ul{margin:12px 0 12px 20px;display:grid;gap:6px}
    .prose blockquote{border-left:3px solid var(--accent);margin:20px 0;color:#a1a1aa;font-style:italic;background:rgba(99,102,241,.06);padding:16px;border-radius:0 12px 12px 0}
    .prose a{color:var(--accent);text-decoration:underline;text-underline-offset:3px}
    .prose code{background:var(--card);border:1px solid var(--border);padding:2px 6px;border-radius:6px;font-family:'JetBrains Mono',monospace;font-size:.9em}
    .prose hr{border:none;border-top:1px solid var(--border);margin:32px 0}
    .prose em{color:var(--muted)}
    .pager{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:32px}
    .pager-link{display:flex;flex-direction:column;gap:6px}
    .pager-link.right{text-align:right}
    .pager-link strong{font-size:.95rem;line-height:1.4}
    .share{margin-top:24px;padding:24px;text-align:center}
    .share .actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:16px}
    .btn{display:inline-flex;padding:10px 18px;border-radius:999px;font-weight:600;font-size:.9rem;border:1px solid var(--border)}
    .btn-dark{background:var(--text);color:var(--bg)}
    .btn-outline{background:transparent;color:var(--text)}
    @media(max-width:640px){.pager{grid-template-columns:1fr}}
  </style>
</Layout>
