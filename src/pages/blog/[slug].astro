---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { base, slugOf, readTime } from '../../utils/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '').split('/').pop() },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const allPosts = await getCollection('blog');
const sorted = [...allPosts].sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date));
const idx = sorted.findIndex((p) => p.id === post.id);
const prev = sorted[idx + 1];
const next = sorted[idx - 1];
const postSlug = slugOf(post);
---
<Layout
  title={`${post.data.title} — Juan Antonio Cano`}
  description={post.data.excerpt}
  canonicalPath={`/blog/${postSlug}/`}
  ogType="article"
  publishedTime={post.data.date}
  tags={[post.data.tag]}
>
  <article class="container post-wrap">
    <div class="meta">
      <a href={`${base}/blog`} class="link">← Back to blog</a>
      <div class="tags">
        <span class="badge">{post.data.tag}</span>
        <span class="mono muted">{post.data.date} · {readTime(post.body)}</span>
      </div>
    </div>
    <h1>{post.data.title}</h1>
    <div class="prose">
      <Content />
    </div>
    {(prev || next) && (
      <nav class="pager">
        {prev ? <a href={`${base}/blog/${slugOf(prev)}`} class="card pager-link"><span class="mono small muted">← Older</span><strong>{prev.data.title}</strong></a> : <span />}
        {next ? <a href={`${base}/blog/${slugOf(next)}`} class="card pager-link right"><span class="mono small muted">Newer →</span><strong>{next.data.title}</strong></a> : <span />}
      </nav>
    )}
    <div class="share card">
      <p class="muted">Was this useful? Share it or contact me.</p>
      <div class="actions">
        <a href="https://www.linkedin.com/in/juanantoniocano/" target="_blank" class="btn btn-outline">Share on LinkedIn</a>
        <a href="mailto:jacanosalado@gmail.com" class="btn btn-dark">Reply by email</a>
      </div>
    </div>
  </article>
  <div id="lightbox" class="lightbox" hidden role="dialog" aria-modal="true" aria-label="Image viewer">
    <div class="lb-bar">
      <span class="lb-caption"></span>
      <div class="lb-tools">
        <button type="button" data-lb="out" aria-label="Zoom out">&#8722;</button>
        <span class="lb-level" aria-live="polite">100%</span>
        <button type="button" data-lb="in" aria-label="Zoom in">+</button>
        <button type="button" data-lb="fit">Fit</button>
        <a class="lb-original" target="_blank" rel="noopener">Open full size</a>
        <button type="button" data-lb="close">Close</button>
      </div>
    </div>
    <div class="lb-stage"><img class="lb-image" alt="" draggable="false" /></div>
  </div>
  <script>
    // A click on any image of the article opens it full screen, where it can be
    // zoomed with the wheel, the buttons or the keyboard, and dragged to move.
    (function () {
      const box = document.getElementById('lightbox') as HTMLElement | null;
      if (!box) return;
      const stage = box.querySelector('.lb-stage') as HTMLElement;
      const image = box.querySelector('.lb-image') as HTMLImageElement;
      const caption = box.querySelector('.lb-caption') as HTMLElement;
      const level = box.querySelector('.lb-level') as HTMLElement;
      const original = box.querySelector('.lb-original') as HTMLAnchorElement;
      const closeButton = box.querySelector('[data-lb="close"]') as HTMLElement;
      let scale = 1;
      let x = 0;
      let y = 0;
      let source: HTMLElement | null = null;
      let dragging = false;
      let lastX = 0;
      let lastY = 0;

      const apply = () => {
        image.style.transform = 'translate(' + x + 'px,' + y + 'px) scale(' + scale + ')';
        level.textContent = Math.round(scale * 100) + '%';
      };
      const reset = () => { scale = 1; x = 0; y = 0; apply(); };
      const zoom = (factor: number, cx?: number, cy?: number) => {
        const next = Math.min(8, Math.max(1, scale * factor));
        if (next === scale) return;
        if (cx !== undefined && cy !== undefined) {
          const r = image.getBoundingClientRect();
          const ratio = next / scale;
          x -= (cx - (r.left + r.width / 2)) * (ratio - 1);
          y -= (cy - (r.top + r.height / 2)) * (ratio - 1);
        }
        scale = next;
        apply();
      };
      const startView = () => {
        reset();
        if (!window.matchMedia('(max-width: 700px)').matches) return;
        const stageRect = stage.getBoundingClientRect();
        const imageRect = image.getBoundingClientRect();
        if (imageRect.width < 100 || imageRect.height < 40) return;
        if (imageRect.width / imageRect.height < 1.3) return;   // only a wide figure gains from this
        const k = Math.min(3, stageRect.height / imageRect.height);
        if (k <= 1.05) return;
        scale = k;
        x = (imageRect.width * k - stageRect.width) / 2;        // start at the left edge
        apply();
      };
      const open = (el: HTMLImageElement) => {
        source = el;
        image.src = el.currentSrc || el.src;
        image.alt = el.alt || '';
        caption.textContent = el.alt || '';
        caption.title = el.alt || '';
        original.href = image.src;
        box.hidden = false;
        document.body.style.overflow = 'hidden';
        startView();
        image.addEventListener('load', startView, { once: true });
        closeButton.focus();
      };
      const close = () => {
        box.hidden = true;
        document.body.style.overflow = '';
        if (source) source.focus();
      };

      box.querySelectorAll('[data-lb]').forEach((button) => {
        button.addEventListener('click', () => {
          const action = button.getAttribute('data-lb');
          if (action === 'in') zoom(1.4);
          else if (action === 'out') zoom(1 / 1.4);
          else if (action === 'fit') reset();
          else close();
        });
      });
      stage.addEventListener('wheel', (event: WheelEvent) => {
        event.preventDefault();
        zoom(event.deltaY < 0 ? 1.15 : 1 / 1.15, event.clientX, event.clientY);
      }, { passive: false });
      stage.addEventListener('pointerdown', (event: PointerEvent) => {
        if (scale === 1) return;
        lastX = event.clientX; lastY = event.clientY;
        try { stage.setPointerCapture(event.pointerId); } catch { /* a capture is a nicety, not a requirement */ }
        dragging = true;
        stage.style.cursor = 'grabbing';
      });
      stage.addEventListener('pointermove', (event: PointerEvent) => {
        if (!dragging) return;
        x += event.clientX - lastX;
        y += event.clientY - lastY;
        lastX = event.clientX; lastY = event.clientY;
        apply();
      });
      const stopDrag = () => { dragging = false; stage.style.cursor = scale > 1 ? 'grab' : 'zoom-in'; };
      stage.addEventListener('pointerup', stopDrag);
      stage.addEventListener('pointercancel', stopDrag);
      image.addEventListener('dblclick', () => { if (scale > 1) reset(); else zoom(2.5); });
      stage.addEventListener('click', (event: MouseEvent) => { if (event.target === stage) close(); });
      document.addEventListener('keydown', (event: KeyboardEvent) => {
        if (box.hidden) return;
        if (event.key === 'Escape') close();
        else if (event.key === '+' || event.key === '=') zoom(1.4);
        else if (event.key === '-' || event.key === '_') zoom(1 / 1.4);
        else if (event.key === '0') reset();
      });

      document.querySelectorAll('.prose img').forEach((node) => {
        const img = node as HTMLImageElement;
        const wrap = document.createElement('span');
        wrap.className = 'zoom-wrap';
        img.replaceWith(wrap);
        wrap.appendChild(img);
        img.tabIndex = 0;
        img.setAttribute('role', 'button');
        img.setAttribute('aria-label', (img.alt ? img.alt + '. ' : '') + 'Open a larger view');
        img.addEventListener('click', () => open(img));
        img.addEventListener('keydown', (event: KeyboardEvent) => {
          if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); open(img); }
        });
      });
    })();
  </script>
  <style is:global>
    .zoom-wrap{position:relative;display:block}
    .zoom-wrap img{cursor:zoom-in;transition:filter .18s}
    .zoom-wrap img:hover,.zoom-wrap img:focus-visible{filter:brightness(1.06)}
    .zoom-wrap::after{
      content:'Click to zoom';position:absolute;right:12px;bottom:32px;
      padding:4px 10px;border-radius:999px;background:rgba(10,10,11,.82);
      border:1px solid var(--border);color:var(--text);
      font-size:.72rem;font-weight:600;opacity:0;transition:opacity .18s;pointer-events:none;
    }
    .zoom-wrap:hover::after,.zoom-wrap:focus-within::after{opacity:1}
    @media (hover:none){.zoom-wrap::after{opacity:1;content:'Tap to zoom'}}
    .lightbox{position:fixed;inset:0;z-index:100;display:flex;flex-direction:column;background:rgba(6,6,8,.94);backdrop-filter:blur(6px)}
    .lightbox[hidden]{display:none}
    .lb-bar{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:10px 16px;border-bottom:1px solid var(--border);background:rgba(10,10,11,.9)}
    .lb-caption{color:var(--muted);font-size:.78rem;line-height:1.4;flex:1 1 240px;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .lb-tools{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
    .lb-tools button,.lb-tools a{
      font:inherit;font-size:.78rem;font-weight:600;color:var(--text);background:var(--card);
      border:1px solid var(--border);border-radius:999px;padding:6px 12px;cursor:pointer;text-decoration:none;
    }
    .lb-tools button:hover,.lb-tools a:hover{border-color:var(--accent);color:#fff}
    .lb-level{font-family:'JetBrains Mono',monospace;font-size:.75rem;color:var(--muted);min-width:44px;text-align:center}
    .lb-stage{flex:1;display:flex;align-items:center;justify-content:center;overflow:hidden;touch-action:none;cursor:zoom-in;padding:16px}
    .lb-image{min-width:0;min-height:0;max-width:100%;max-height:100%;width:auto;height:auto;border-radius:10px;border:1px solid var(--border);transform-origin:center center;will-change:transform;user-select:none}
  </style>
  <script>
    document.querySelectorAll('.prose pre').forEach((pre) => {
      const code = pre.querySelector('code');
      if (!code) return;
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'copy-btn';
      button.textContent = 'Copy';
      button.setAttribute('aria-label', 'Copy this code');
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText((code as HTMLElement).innerText);
          button.textContent = 'Copied';
        } catch {
          button.textContent = 'Press Ctrl+C';
        }
        window.setTimeout(() => { button.textContent = 'Copy'; }, 1600);
      });
      pre.appendChild(button);
    });
  </script>
  <style is:global>
    .copy-btn{
      position:absolute;top:10px;right:10px;
      font:inherit;font-size:.72rem;font-weight:600;
      padding:4px 10px;border-radius:999px;
      background:var(--bg2);color:var(--muted);
      border:1px solid var(--border);cursor:pointer;
      opacity:.55;transition:opacity .2s,color .2s;
    }
    .copy-btn:hover,.copy-btn:focus-visible{opacity:1;color:var(--text)}
  </style>
  <style>
    .post-wrap{max-width:720px;padding:48px 24px}
    .meta{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:24px;align-items:center}
    .tags{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
    .link{color:var(--accent);font-weight:600}
    .badge{padding:4px 10px;border-radius:999px;background:rgba(99,102,241,.15);color:#a5b4fc;font-size:.7rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;border:1px solid rgba(99,102,241,.3)}
    .mono{font-family:'JetBrains Mono',monospace;font-size:.8rem}
    .small{font-size:.75rem}
    h1{font-size:2.2rem;line-height:1.15;letter-spacing:-0.03em;margin-bottom:24px}
    .prose{color:#d4d4d8;line-height:1.85;font-size:1.02rem}
    .prose :global(h2){color:var(--text);margin:44px 0 14px;font-size:1.45rem;letter-spacing:-0.02em}
    .prose :global(h3){color:var(--text);margin:28px 0 10px;font-size:1.15rem}
    .prose :global(p){margin:16px 0}
    .prose :global(ul),.prose :global(ol){margin:16px 0 16px 22px;display:grid;gap:8px}
    .prose :global(li){line-height:1.7}
    .prose :global(strong){color:var(--text)}
    .prose :global(em){color:var(--muted)}
    .prose :global(a){color:var(--accent);text-decoration:underline;text-underline-offset:3px}
    .prose :global(hr){border:none;border-top:1px solid var(--border);margin:44px 0}
    .prose :global(table){width:100%;border-collapse:separate;border-spacing:0;margin:28px 0;font-size:.92rem;border:1px solid var(--border);border-radius:12px;overflow:hidden;font-variant-numeric:tabular-nums}
    .prose :global(th),.prose :global(td){text-align:left;padding:11px 14px;border-bottom:1px solid rgba(148,163,184,.16);vertical-align:top}
    .prose :global(thead th){background:var(--card);color:var(--muted);font-size:.72rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap;border-bottom-color:#475569}
    .prose :global(tbody tr:nth-child(odd)){background:rgba(255,255,255,.035)}
    .prose :global(tbody tr:last-child td){border-bottom:none}
    .prose :global(tbody tr:hover){background:rgba(99,102,241,.06)}
    @media(max-width:640px){
      .prose :global(table){display:block;overflow-x:auto}
      .prose :global(th:first-child),.prose :global(td:first-child){position:sticky;left:0;background:var(--bg);z-index:1}
    }
    .prose :global(blockquote){border-left:3px solid var(--accent);margin:24px 0;color:#c7c7cf;background:rgba(99,102,241,.08);padding:4px 20px;border-radius:0 12px 12px 0;font-style:italic}
    .prose :global(blockquote p){margin:14px 0}
    .prose :global(code){background:var(--card);border:1px solid var(--border);padding:2px 6px;border-radius:6px;font-family:'JetBrains Mono',monospace;font-size:.88em}
    .prose :global(pre){position:relative;background:var(--card);border:1px solid var(--border);border-radius:12px;padding:16px 18px;overflow-x:auto;margin:20px 0}
    .prose :global(pre code){background:none;border:none;padding:0;font-size:.85rem;line-height:1.6}
    .prose :global(img){max-width:100%;height:auto;border-radius:12px;border:1px solid var(--border);margin:20px 0}
    .pager{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:32px}
    .pager-link{display:flex;flex-direction:column;gap:6px}
    .pager-link.right{text-align:right}
    .pager-link strong{font-size:.95rem;line-height:1.4}
    .share{margin-top:24px;padding:24px;text-align:center}
    .share .actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:16px}
    .btn{display:inline-flex;padding:10px 18px;border-radius:999px;font-weight:600;font-size:.9rem;border:1px solid var(--border)}
    .btn-dark{background:var(--text);color:var(--bg)}
    .btn-outline{background:transparent;color:var(--text)}
    @media(max-width:640px){.pager{grid-template-columns:1fr}}
  </style>
</Layout>
