---
import Layout from '../../layouts/Layout.astro';
const rawBase = import.meta.env.BASE_URL; const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
const posts = [
  {
    slug: 'web3-security-posture-management',
    title: 'From audits to continuous posture: why Web3 needs W3SPM',
    date: '2025-11-15',
    excerpt: 'Over 75% of losses in 2026 came from operational gaps, not code bugs. Dedge builds continuous security from code to chain.',
    tag: 'Web3 Security',
    read: '7 min'
  },
  {
    slug: 'c-sharp-interop-nativo',
    title: 'C# native interop: 10 years of lessons with Box2DCS and Crunch',
    date: '2025-08-02',
    excerpt: 'Learn to build C++ and C# bindings. The methods are P/Invoke, C++/CLI, marshalling and performance tuning. This article shows patterns from ManagedCrunch and Box2DCS.',
    tag: 'C# / C++',
    read: '10 min'
  },
  {
    slug: 'head-of-engineering-remoto',
    title: 'Lead remote engineering: culture, delivery and trust',
    date: '2025-05-20',
    excerpt: 'This is my playbook as Head of Engineering. It covers rituals that work and metrics that matter. It shows hiring and team scaling without loss of quality.',
    tag: 'Leadership',
    read: '6 min'
  },
  {
    slug: 'primer-post',
    title: 'Hello world: why I started this blog',
    date: '2025-04-10',
    excerpt: 'I built software for 14 years. Now I document what I learned. The topics are architecture, Web3 security and technical leadership.',
    tag: 'Personal',
    read: '3 min'
  },
  {
    slug: 'realtime-mobile-object-detector-xamarin-android',
    title: 'Realtime mobile object detector in Xamarin.Android',
    date: '2019-07-04',
    excerpt: 'How we built TailwindTraders AR with Xamarin.Android, EmguTF and TensorFlow Lite. SSD MobileNet, NV21 to RGB in native code, SkiaSharp and 7 fps on Pixel XL.',
    tag: 'Archive · Xamarin',
    read: '8 min'
  },
  {
    slug: 'wasm-sample-mono-webassembly-sdk',
    title: 'WasmSample: .NET on WebAssembly with Mono.WebAssembly.Sdk',
    date: '2019-05-04',
    excerpt: 'Sample WASM project with Mono.WebAssembly.Sdk. It shows .NET on WebAssembly and links to my WASM work in dotnet/corert (CLR).',
    tag: 'Archive · WASM',
    read: '4 min'
  }
];
---
<Layout title="Blog — Juan Antonio Cano Salado" description="Articles on Web3 security, C# and .NET, architecture and technical leadership by Juan Antonio Cano Salado.">
  <div class="container blog-wrap">
    <div class="header">
      <h1>Blog</h1>
      <p class="muted">I write about Web3 security, architecture, .NET and leadership. I publish when I have something useful to share.</p>
      <div class="meta mono small muted">RSS coming soon · {posts.length} articles</div>
    </div>

    <div class="list">
      {posts.map(p => (
        <a href={`${base}/blog/${p.slug}`} class="card row">
          <div class="row-main">
            <div class="row-top">
              <span class="badge">{p.tag}</span>
              <span class="mono small muted">{p.date} · {p.read}</span>
            </div>
            <h2>{p.title}</h2>
            <p class="muted">{p.excerpt}</p>
            <span class="link">Read →</span>
          </div>
        </a>
      ))}
    </div>

    <div class="card cta">
      <h3>Want to collaborate?</h3>
      <p class="muted">You like Web3 posture, ASPM or native interop. Then we can talk. I also welcome guest post proposals.</p>
      <a href="mailto:jacanosalado@gmail.com" class="btn btn-dark">Get in touch</a>
    </div>
  </div>
  <style>
    .blog-wrap{padding:48px 0;max-width:800px}
    .header{margin-bottom:32px}
    .header h1{font-size:2.8rem;letter-spacing:-0.03em;margin-bottom:8px}
    .list{display:grid;gap:16px;margin-bottom:32px}
    .row{padding:24px;transition:border-color .2s}
    .row:hover{border-color:rgba(99,102,241,.4)}
    .row-top{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-bottom:8px}
    .badge{padding:4px 10px;border-radius:999px;background:rgba(99,102,241,.15);color:#a5b4fc;font-size:.7rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;border:1px solid rgba(99,102,241,.3)}
    .small{font-size:.8rem}
    .row h2{font-size:1.25rem;line-height:1.3;margin-bottom:8px}
    .link{color:var(--accent);font-weight:600;font-size:.9rem}
    .cta{padding:32px;text-align:center}
    .cta .btn{margin-top:12px}
  </style>
</Layout>
